# --- Search Provider: SerpApi Google Lens ---
SERPAPI_KEY=your_serpapi_key

# --- IPFS Storage: Pinata JWT ---
PINATA_JWT=your_pinata_jwt

# --- Blockchain: Polygon Amoy Testnet (Chain ID 80002) ---
AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
PRIVATE_KEY=your_testnet_wallet_private_key
CONTRACT_ADDRESS=fill_in_after_running_deploy_script

# --- Pipeline Decision Engine Thresholds (ArcFace Buffalo_l) ---
# VERIFIED: High-confidence face similarity cutoff (default: 0.40)
VERIFIED_THRESHOLD=0.40

# REVIEW: Moderate face similarity cutoff requiring manual review (default: 0.30)
REVIEW_THRESHOLD=0.30

