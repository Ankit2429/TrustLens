# ==============================================================================
# TrustLens Environment Configuration Template
# ==============================================================================

# --- Search Provider: SerpApi Google Lens ---
SERPAPI_KEY=your_serpapi_key

# --- IPFS Storage: Pinata JWT ---
PINATA_JWT=your_pinata_jwt

# --- Blockchain Network Layer ---
# Supported networks: anvil (local development) | polygon_amoy (public testnet)
BLOCKCHAIN_NETWORK=anvil

# --- Option A: Local Foundry Anvil (Default for Development / Testing) ---
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
# Anvil Account #0 pre-funded test key (publicly known Foundry dev key):
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BLOCKCHAIN_CONTRACT_ADDRESS=fill_in_after_running_npm_run_deploy_anvil

# --- Option B: Polygon Amoy Public Testnet (Uncomment to switch) ---
# BLOCKCHAIN_NETWORK=polygon_amoy
# BLOCKCHAIN_RPC_URL=https://polygon-amoy.drpc.org
# BLOCKCHAIN_CHAIN_ID=80002
# BLOCKCHAIN_PRIVATE_KEY=your_amoy_testnet_private_key
# BLOCKCHAIN_CONTRACT_ADDRESS=your_deployed_amoy_contract_address

# --- Legacy Compatibility Aliases (Optional) ---
# AMOY_RPC_URL=https://polygon-amoy.drpc.org
# PRIVATE_KEY=your_testnet_wallet_private_key
# CONTRACT_ADDRESS=your_deployed_contract_address

# --- Face Verification Thresholds (ArcFace Cosine Similarity: -1.0 to 1.0)
# VERIFIED_THRESHOLD: High-confidence verified match cutoff (default: 0.60, FMR < 10^-6)
# REVIEW_THRESHOLD  : Ambiguous / borderline cutoff requiring manual inspection (default: 0.40)
# MIN_QUALITY_THRESHOLD: Minimum composite face quality score (default: 0.20)
VERIFIED_THRESHOLD=0.60
REVIEW_THRESHOLD=0.40
MIN_QUALITY_THRESHOLD=0.20
